{
  "name": "@socialvibe/centralize",
  "version": "2.0.1",
  "description": "A simple JS message hub",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit.xml",
    "test:watch": "node --test --watch",
    "coverage": "node --test --experimental-test-coverage",
    "check-release": "node scripts/check-release.ts",
    "prepack": "npm run clean && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/socialvibe/centralize-js.git"
  },
  "keywords": [],
  "author": "Vincent Cheung",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/socialvibe/centralize-js/issues"
  },
  "homepage": "https://github.com/socialvibe/centralize-js#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
